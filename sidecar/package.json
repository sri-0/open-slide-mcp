{
  "name": "open-slide-sidecar",
  "private": true,
  "type": "module",
  "description": "Parse-only sidecar that applies the open-slide editor's source patches for the Go server.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "upstream": "node fetch-upstream.mjs",
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --sourcemap --outfile=dist/server.js",
    "start": "node --permission --allow-fs-read=./dist dist/server.js"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@babel/types": "7.29.8"
  },
  "devDependencies": {
    "esbuild": "0.28.0"
  }
}
